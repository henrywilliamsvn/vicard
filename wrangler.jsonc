{
  "name": "vicard",
  "compatibility_date": "2026-06-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /media/* must reach the Worker first so a missing video is a real 404,
    // not the SPA's index.html.
    "run_worker_first": ["/media/*"]
  },
  // Meo videos + covers. Bucket created in the Cloudflare dashboard (R2).
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "meo-media" }
  ]
}
